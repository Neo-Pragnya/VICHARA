---
import { getCollection } from "astro:content";
import SiteLayout from "../components/SiteLayout.astro";
import { documentHref, isWebsitePublished } from "../lib/docs";

const documents = (await getCollection("docs"))
  .filter(isWebsitePublished)
  .sort((left, right) => left.id.localeCompare(right.id));
const featured = documents.find((document) =>
  document.id.endsWith("ideation-and-implementation-plan"),
);
---

<SiteLayout
  title="Where Curiosity Becomes Creation"
  description="A living atlas connecting VICHARA's ideas, research, hypotheses, architecture, and products."
>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">A living knowledge atlas</p>
        <h1>Where curiosity<br /><span data-scramble>becomes creation.</span></h1>
        <p class="hero-description">
          Follow the path from a spark of an idea to evidence, experiments,
          architecture, and things worth building.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${import.meta.env.BASE_URL}docs/`}>
            Explore the knowledge atlas <span aria-hidden="true">→</span>
          </a>
          <a
            class="button button-secondary"
            href="https://github.com/Neo-Pragnya/VICHARA"
          >
            Browse the repository
          </a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <canvas data-field="24" data-seed="11" data-colors="#285c43,#6fb58a,#b5e655,#46d1c6,#ffd84d,#a8d5ba,#ff9f7a"></canvas>
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="orbit orbit-three"></div>
        <span class="orbit-center">
          <svg class="orbit-glyph" viewBox="0 0 100 100" data-morph="flower star6 blob circle flower8" data-morph-auto="2600"></svg>
          <span>Vicāra</span>
        </span>
        <span class="orbit-label label-ideas" data-magnetic="0.35">💡 Ideas</span>
        <span class="orbit-label label-research" data-magnetic="0.35">📚 Research</span>
        <span class="orbit-label label-build" data-magnetic="0.35">🏗️ Build</span>
        <span class="orbit-label label-learn" data-magnetic="0.35">🌱 Learn</span>
      </div>
    </section>

    <section class="lens-section" aria-labelledby="lenses-title">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">A constellation, not a checklist</p>
        <h2 id="lenses-title">Seven lenses on one evolving body of knowledge.</h2>
      </div>
      <div class="lens-grid">
        <a data-tilt data-reveal style="--d:0.00s" href={`${import.meta.env.BASE_URL}docs/vision/`}><svg class="lens-glyph" viewBox="0 0 100 100" data-morph="circle>star" aria-hidden="true"></svg><span>🧭</span><strong>Vision</strong><small>Why it matters</small></a>
        <a data-tilt data-reveal style="--d:0.04s" href={`${import.meta.env.BASE_URL}docs/ideas/`}><svg class="lens-glyph" viewBox="0 0 100 100" data-morph="blob>flower" aria-hidden="true"></svg><span>💡</span><strong>Ideas</strong><small>What could be</small></a>
        <a data-tilt data-reveal style="--d:0.08s" href={`${import.meta.env.BASE_URL}docs/conceptualization/`}><svg class="lens-glyph" viewBox="0 0 100 100" data-morph="squircle>spark" aria-hidden="true"></svg><span>🧠</span><strong>Conceptualization</strong><small>How it might work</small></a>
        <a data-tilt data-reveal style="--d:0.12s" href={`${import.meta.env.BASE_URL}docs/hypothesis/`}><svg class="lens-glyph" viewBox="0 0 100 100" data-morph="triangle>star6" aria-hidden="true"></svg><span>🧪</span><strong>Hypothesis</strong><small>What can we test?</small></a>
        <a data-tilt data-reveal style="--d:0.16s" href={`${import.meta.env.BASE_URL}docs/analysis/`}><svg class="lens-glyph" viewBox="0 0 100 100" data-morph="hex>flower8" aria-hidden="true"></svg><span>🔎</span><strong>Analysis</strong><small>What does evidence say?</small></a>
        <a data-tilt data-reveal style="--d:0.20s" href={`${import.meta.env.BASE_URL}docs/research/`}><svg class="lens-glyph" viewBox="0 0 100 100" data-morph="diamond>star4" aria-hidden="true"></svg><span>📚</span><strong>Research</strong><small>What is known?</small></a>
        <a data-tilt data-reveal style="--d:0.24s" href={`${import.meta.env.BASE_URL}docs/architectures/`}><svg class="lens-glyph" viewBox="0 0 100 100" data-morph="octagon>gear" aria-hidden="true"></svg><span>🏗️</span><strong>Architecture</strong><small>How do we build?</small></a>
        <a data-tilt data-reveal style="--d:0.28s" href={`${import.meta.env.BASE_URL}docs/products/`}><svg class="lens-glyph" viewBox="0 0 100 100" data-morph="blob2>star" aria-hidden="true"></svg><span>🚀</span><strong>Products</strong><small>What can we create?</small></a>
      </div>
    </section>

    <section class="featured-section">
      <div>
        <p class="eyebrow">First product exploration</p>
        <h2>Meet Pensieve</h2>
        <p>
          An early exploration into how an AI product might connect user
          journeys with the technical events behind them. The plan is a
          research-stage draft—not a verified product specification.
        </p>
        {
          featured && (
            <a class="text-link" href={documentHref(featured.id)}>
              Read the ideation and implementation plan →
            </a>
          )
        }
      </div>
      <div class="featured-note">
        <svg class="featured-glyph" viewBox="0 0 100 100" data-morph="blob flower star hex blob3" data-morph-auto="2200" aria-hidden="true"></svg>
        <span class="featured-icon" aria-hidden="true">🧠</span>
        <span class="featured-caption">Questions → evidence → understanding</span>
      </div>
    </section>

    <section class="how-section" data-reveal>
      <p class="eyebrow">Made for connected thinking</p>
      <h2>Keep the thinking.<br />Not just the finished thing.</h2>
      <p>
        Source material lives in versioned Markdown. The website turns
        explicitly approved documents into browsable pages, while the
        repository remains the source of truth.
      </p>
      <a class="text-link" href={`${import.meta.env.BASE_URL}docs/`}>
        Browse all <span data-countup>{documents.length}</span> published documents →
      </a>
    </section>
  </main>
</SiteLayout>
