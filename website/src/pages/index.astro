---
import { site } from "../lib/site";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={site.description} />
    <title>{site.name} — {site.tagline}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">A living knowledge atlas</p>
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <p class="description">{site.description}</p>
      <p class="status">
        VICHARA is in its foundation phase. The product and engineering
        specifications are being turned into a tested, static site.
      </p>
    </main>
  </body>
</html>
