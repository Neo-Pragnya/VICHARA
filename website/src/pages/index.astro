---
import { getCollection } from "astro:content";
import SiteLayout from "../components/SiteLayout.astro";
import { documentHref, isWebsitePublished } from "../lib/docs";

const documents = (await getCollection("docs"))
  .filter(isWebsitePublished)
  .sort((left, right) => left.id.localeCompare(right.id));
const featured = documents.find((document) =>
  document.id.endsWith("ideation-and-implementation-plan"),
);
---

<SiteLayout
  title="Where Curiosity Becomes Creation"
  description="A living atlas connecting VICHARA's ideas, research, hypotheses, architecture, and products."
>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">A living knowledge atlas</p>
        <h1>Where curiosity<br /><span>becomes creation.</span></h1>
        <p class="hero-description">
          Follow the path from a spark of an idea to evidence, experiments,
          architecture, and things worth building.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={`${import.meta.env.BASE_URL}docs/`}>
            Explore the knowledge atlas <span aria-hidden="true">→</span>
          </a>
          <a
            class="button button-secondary"
            href="https://github.com/Neo-Pragnya/VICHARA"
          >
            Browse the repository
          </a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="orbit orbit-three"></div>
        <span class="orbit-center">Vicāra</span>
        <span class="orbit-label label-ideas">💡 Ideas</span>
        <span class="orbit-label label-research">📚 Research</span>
        <span class="orbit-label label-build">🏗️ Build</span>
        <span class="orbit-label label-learn">🌱 Learn</span>
      </div>
    </section>

    <section class="lens-section" aria-labelledby="lenses-title">
      <div class="section-heading">
        <p class="eyebrow">A constellation, not a checklist</p>
        <h2 id="lenses-title">Seven lenses on one evolving body of knowledge.</h2>
      </div>
      <div class="lens-grid">
        <a href={`${import.meta.env.BASE_URL}docs/vision/`}><span>🧭</span><strong>Vision</strong><small>Why it matters</small></a>
        <a href={`${import.meta.env.BASE_URL}docs/ideas/`}><span>💡</span><strong>Ideas</strong><small>What could be</small></a>
        <a href={`${import.meta.env.BASE_URL}docs/conceptualization/`}><span>🧠</span><strong>Conceptualization</strong><small>How it might work</small></a>
        <a href={`${import.meta.env.BASE_URL}docs/hypothesis/`}><span>🧪</span><strong>Hypothesis</strong><small>What can we test?</small></a>
        <a href={`${import.meta.env.BASE_URL}docs/analysis/`}><span>🔎</span><strong>Analysis</strong><small>What does evidence say?</small></a>
        <a href={`${import.meta.env.BASE_URL}docs/research/`}><span>📚</span><strong>Research</strong><small>What is known?</small></a>
        <a href={`${import.meta.env.BASE_URL}docs/architectures/`}><span>🏗️</span><strong>Architecture</strong><small>How do we build?</small></a>
        <a href={`${import.meta.env.BASE_URL}docs/products/`}><span>🚀</span><strong>Products</strong><small>What can we create?</small></a>
      </div>
    </section>

    <section class="featured-section">
      <div>
        <p class="eyebrow">First product exploration</p>
        <h2>Meet Pensieve</h2>
        <p>
          An early exploration into how an AI product might connect user
          journeys with the technical events behind them. The plan is a
          research-stage draft—not a verified product specification.
        </p>
        {
          featured && (
            <a class="text-link" href={documentHref(featured.id)}>
              Read the ideation and implementation plan →
            </a>
          )
        }
      </div>
      <div class="featured-note">
        <span class="featured-icon" aria-hidden="true">🧠</span>
        <span class="featured-caption">Questions → evidence → understanding</span>
      </div>
    </section>

    <section class="how-section">
      <p class="eyebrow">Made for connected thinking</p>
      <h2>Keep the thinking.<br />Not just the finished thing.</h2>
      <p>
        Source material lives in versioned Markdown. The website turns
        explicitly approved documents into browsable pages, while the
        repository remains the source of truth.
      </p>
      <a class="text-link" href={`${import.meta.env.BASE_URL}docs/`}>
        Browse all {documents.length} published documents →
      </a>
    </section>
  </main>
</SiteLayout>
